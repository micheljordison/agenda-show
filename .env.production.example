COMPOSE_PROJECT_NAME=agenda-production
ENVIRONMENT=production
POSTGRES_USER=agenda
POSTGRES_PASSWORD=change-this-to-a-random-password
POSTGRES_DB=agenda
JWT_SECRET_KEY=change-this-to-a-random-secret-of-at-least-32-characters
