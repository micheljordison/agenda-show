# Copy to .env.production. Never commit the actual values.
# Keep the same Compose project name between releases (especially with a local database).
COMPOSE_PROJECT_NAME=agenda-production
ENVIRONMENT=production
# External PostgreSQL (RDS): URL-encode username/password special characters; require TLS.
DATABASE_URL=postgresql+psycopg://agenda:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_RDS_ENDPOINT:5432/agenda?sslmode=require&connect_timeout=5
# If using docker-compose.postgres.yml, set DATABASE_URL to:
# postgresql+psycopg://agenda:YOUR_PASSWORD@database:5432/agenda?connect_timeout=5
POSTGRES_USER=agenda
POSTGRES_PASSWORD=change-this-to-a-random-password
POSTGRES_DB=agenda
JWT_SECRET_KEY=change-this-to-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Empty is sufficient when frontend and /api share the same HTTPS domain.
BACKEND_CORS_ORIGINS=
# Used only by the explicit bootstrap command, not normal production startup.
INITIAL_MASTER_USERNAME=admin
INITIAL_MASTER_NAME=Administrador
INITIAL_MASTER_PASSWORD=change-this-to-a-random-password
# Default: accessible only by a reverse proxy on this host.
# On EC2 behind ALB, use 0.0.0.0 and allow port 8080 ONLY from the ALB security group.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# For docker-compose.https.yml: hostname only, without https:// or path.
APP_DOMAIN=agenda.example.com
